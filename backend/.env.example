PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password
DB_NAME=tennis_system
DB_SSL=false

JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# SMTP settings used for password resets and account email notifications.
# Gmail example: smtp.gmail.com, port 587, with a Google App Password.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-user
EMAIL_PASS=replace-with-your-smtp-password
EMAIL_FROM=TennisCourt <noreply@example.com>
